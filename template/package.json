  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:pruef": "next start -p 3111",
    "lint": "eslint",
    "check:types": "tsc --noEmit",
    "check:a11y": "start-server-and-test start:pruef http://localhost:3111 \"node scripts/check-a11y.mjs\"",
    "check:deutsch": "start-server-and-test start:pruef http://localhost:3111 \"node scripts/check-deutsch.mjs\"",
    "check:kontrast": "start-server-and-test start:pruef http://localhost:3111 \"node scripts/check-kontrast.mjs\"",
    "check:formular": "node scripts/check-formular.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:all": "npm run check:types && npm run lint && npm run build && npm run check:a11y && npm run check:deutsch && npm run check:kontrast && npm run check:perf && npm run check:budget"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
