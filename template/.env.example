# Vorlage. Kopieren nach `.env.local` und ausfüllen.
# `.env*` steht in .gitignore — echte Werte gehören NIE in den Code
# und NIE in diese Datei.

# Kanonische Adresse der Seite, ohne abschließenden Schrägstrich.
# Ohne diesen Wert zeigen Sitemap, Canonical und Open Graph auf localhost.
NEXT_PUBLIC_SITE_URL=https://www.example.de

# Empfänger der Kontaktanfragen. Fehlt der Wert, bricht die Server Action in
# Produktion bewusst ab, statt Anfragen still zu verlieren.
KONTAKT_EMPFAENGER=anfragen@example.de

# Zugangsdaten des Versanddienstes (pro Projekt einsetzen).
# MAIL_API_KEY=
